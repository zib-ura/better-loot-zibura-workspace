# Repository metadata
.gitattributes text eol=lf
.gitignore     text eol=lf

# Default text normalization
* text=auto

# Source code
*.py      text eol=lf
*.java    text eol=lf
*.js      text eol=lf

# Minecraft / configuration / data
*.json    text eol=lf
*.json5   text eol=lf
*.toml    text eol=lf
*.mcmeta  text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Unix scripts
*.sh      text eol=lf

# Windows scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary
*.jar     binary
*.zip     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.nbt     binary
*.class   binary